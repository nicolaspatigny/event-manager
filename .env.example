# Copy to .env and generate unique values; never commit .env.
JWT_SECRET=replace-with-at-least-32-random-bytes
MONGO_ROOT_USER=eventadmin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-hex-password
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-12-character-minimum-password
WEB_PORT=8081
# Optional only for scripts/seed-demo.mjs (not required for normal startup):
DEMO_PASSWORD=replace-with-a-unique-12-character-minimum-password
